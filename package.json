{
  "name": "@driftdev/buoy",
  "version": "0.5.0",
  "description": "Docs review overlay. Drift finds it, Buoy marks it: spec-checked findings pinned on your rendered docs page.",
  "keywords": [
    "docs",
    "documentation",
    "drift",
    "review",
    "overlay",
    "devtool"
  ],
  "license": "MIT",
  "author": "Ryan Waits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwaits/buoy.git"
  },
  "homepage": "https://github.com/ryanwaits/buoy#readme",
  "bugs": {
    "url": "https://github.com/ryanwaits/buoy/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.10",
  "bin": {
    "buoy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bunup && chmod +x dist/cli.js",
    "dev": "bunup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "prepublishOnly": "bun run build",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@driftdev/sdk": "^1.18.0",
    "@openpkg-ts/sdk": "^0.55.0",
    "@openpkg-ts/spec": "^0.55.0",
    "node-html-parser": "^9.0.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "@typesafe-ai/sdk": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@typesafe-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^2.31.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "bunup": "0.16.32",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
